rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Secure rule for newsletter subscription collection
    match /newsletter/{document} {
      allow create: if request.resource.data.email != null 
                    && request.resource.data.email is string 
                    && request.resource.data.email.size() < 150
                    && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }

    // Secure rule for leads collection (Get a Free Demo modal)
    match /leads/{document} {
      allow create: if request.resource.data.name != null 
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 100
                    && request.resource.data.phone != null
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() < 30
                    && request.resource.data.businessName is string
                    && request.resource.data.businessName.size() < 150
                    && request.resource.data.niche is string
                    && request.resource.data.niche.size() < 50
                    && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }

    // Secure rule for trials collection (Start 14-day trial modal)
    match /trials/{document} {
      allow create: if request.resource.data.name != null 
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 100
                    && request.resource.data.phone != null
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() < 30
                    && request.resource.data.businessName is string
                    && request.resource.data.businessName.size() < 150
                    && request.resource.data.email != null
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 150
                    && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }
  }
}
